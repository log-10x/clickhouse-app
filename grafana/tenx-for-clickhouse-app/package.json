{
  "name": "log10x-tenx-app",
  "version": "0.1.0",
  "description": "10x for ClickHouse — Grafana app plugin with pattern explorer and dashboards",
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "test": "jest --config jest.config.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint --cache --fix 'src/**/*.{ts,tsx}'",
    "spellcheck": "cspell -c cspell.config.json 'src/**/*.{ts,tsx}'",
    "server": "docker-compose up --build"
  },
  "license": "Apache-2.0",
  "author": "Log10x, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/log-10x/clickhouse-app",
    "directory": "grafana/tenx-for-clickhouse-app"
  },
  "devDependencies": {
    "@grafana/eslint-config": "^7.0.0",
    "@grafana/tsconfig": "^1.3.0-rc1",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.7",
    "@types/react": "18.2.x",
    "@types/react-dom": "18.2.x",
    "typescript": "5.x"
  },
  "dependencies": {
    "@emotion/css": "11.x",
    "@grafana/data": "10.4.x",
    "@grafana/runtime": "10.4.x",
    "@grafana/ui": "10.4.x",
    "react": "18.2.x",
    "react-dom": "18.2.x"
  },
  "engines": {
    "node": ">=18"
  }
}
